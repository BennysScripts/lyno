{
  "name": "lyno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:local": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/package.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "jobs": "tsx --env-file=.env scripts/jobs.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "mailbox": "tsx scripts/mailbox.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json *.md docs/*.md",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json *.md docs/*.md",
    "campaign": "tsx --env-file=.env scripts/campaign.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "image-size": "^2.0.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
