APP_URL=http://localhost:3000
DATABASE_URL=postgres://lyno_app:lyno_local_app@127.0.0.1:5432/lyno
MIGRATION_DATABASE_URL=postgres://lyno:lyno_local_dev@127.0.0.1:5432/lyno
DB_APP_PASSWORD=lyno_local_app
MAIL_MODE=local
ASSIST_MODE=test
# Explicit opt-in only; never enable automatically when a key is present.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BILLING_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=
PRICE_STARTER_EUR=149
PRICE_BUSINESS_EUR=299
# Needed to use cookies without TLS in local production-build testing only.
ALLOW_INSECURE_LOCALHOST=true
# Optional verified operator values; absence is displayed honestly.
# LEGAL_COMPANY=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# Optional absolute path for local mailbox storage. Runtime data never belongs in builds.
# LYNO_DATA_DIR=/var/lib/lyno
LYNO_BIND_HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
# SMTP is opt-in; no messages leave the machine in MAIL_MODE=local.
# MAIL_MODE=smtp
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# 32 random bytes, base64 encoded; keep outside database and release artifacts.
# MAIL_ENCRYPTION_KEY=

# Zentrale Preise: Gesamtbundles und CORE ohne Zusatzmodule (EUR netto/Monat)
PRICE_PREMIUM_EUR=499
PRICE_CORE_STARTER_EUR=49
PRICE_CORE_BUSINESS_EUR=199
PRICE_CORE_PREMIUM_EUR=399
PRICE_FLOW_EUR=35
PRICE_ACADEMY_EUR=35
PRICE_ASSIST_EUR=39
PRICE_INSIGHTS_EUR=29
